# Copy this file to .env and fill in the values:  cp .env.example .env
# Then run:  node scripts/generate-config.js   (creates assets/js/config.js)
#
# IMPORTANT: this is a static site. Every value below ends up in config.js,
# which the browser downloads. Never put real secrets (passwords, private API
# keys) here. Only public values.

# --- Contact form (Web3Forms) -------------------------------------------
# Get a free access key at https://web3forms.com. Keys are meant to be public;
# restrict them to your domain in the Web3Forms dashboard.
WEB3FORMS_ACCESS_KEY=

# Max messages one visitor can send per 24 hours (counted in their browser)
CONTACT_MAX_PER_DAY=10

# --- Site ----------------------------------------------------------------
# Where messages are delivered and shown in error text
CONTACT_EMAIL=itechdummvry@gmail.com

# Production URL, no trailing slash (for canonical links / sharing)
SITE_URL=https://example.com

# development | production
APP_ENV=development
